# Als .env im Projektordner speichern, dann Server neu starten.
# Nur kostenloses Supabase-Projekt; niemals Service-Role-Key eintragen.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Nur Gemini-Projekt OHNE aktiviertes Billing/Kreditkarte verwenden.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FREE_TIER_CONFIRMED=false
# Maximale Gemini-Aufrufe pro Tag und Serverlauf (Sortierung + Dienstplan-Fotos).
GEMINI_DAILY_LIMIT=100
PORT=4173
# Nur für die gehostete Version (npm run build:static): Anmeldung beim Start anbieten (true/false).
KOMPASS_REQUIRE_LOGIN=true
